<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.chegadebet</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>chega-de-bet-backend</name>
    <description>Backend de denúncia e moderação do Chega de Bet</description>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.0.3</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <ahocorasick.version>0.6.3</ahocorasick.version>
        <jsoup.version>1.21.2</jsoup.version>
    </properties>

    <dependencies>
        <!-- Web / API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistência (JPA) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Segurança: autentica o painel de moderação.
             Entrar no classpath protege TODAS as rotas por padrão, então os endpoints
             anônimos (denúncia, token) são liberados explicitamente em SecurityConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validação (Bean Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Observabilidade: health, info, métricas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Exportador de métricas para Prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migrations de banco.
             No Spring Boot 4 a auto-configuração do Flyway saiu do módulo monolítico:
             flyway-core sozinho não é mais detectado. O starter é quem traz a
             auto-config (+ o flyway-core transitivamente) e faz as migrations rodarem. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Driver PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Documentação da API (OpenAPI 3 + Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Rate-limit (token bucket).
             Só o core: os módulos de cluster (Redis, Hazelcast, Ignite) trariam
             infraestrutura que o projeto ainda não precisa. Os baldes vivem no heap
             desta instância — ver TokenRateLimiter para a consequência disso ao escalar. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- ===== Pré-análise de domínio (scraper) ===== -->

        <!-- Casamento de muitos termos em uma passagem só (Aho-Corasick).
             Um Trie imutável, construído uma vez na subida, varre o texto em O(n) no
             tamanho do texto — independente de quantos termos o dicionário tem. Com
             regex seria uma passagem por termo, e o dicionário cresce a cada provedor
             ou licenciadora nova.
             onlyWholeWords() é o motivo de não escrevermos o autômato à mão: sem
             fronteira de palavra, "bet" casa com Betim, diabetes e Roberto. -->
        <dependency>
            <groupId>org.ahocorasick</groupId>
            <artifactId>ahocorasick</artifactId>
            <version>${ahocorasick.version}</version>
        </dependency>

        <!-- Parser de HTML.
             Entrou porque a medição em docs/pre-analise-scraping.md mostrou que a maior
             fonte de falso positivo é texto que não é texto da página: nome de arquivo
             (betbr-blaze-prodfavicon.ico), variável CSS (bet-win-color) e lista de
             ícones do Material Symbols (icon_names=...,casino,...). Todos vivem dentro
             de <script>, <style> ou de atributos. Casar sobre o HTML cru contaria os
             três; o Jsoup separa <title>, <meta> e o texto visível, e o resto é
             descartado antes do matcher ver.
             Falso positivo é falha crítica neste projeto — a dependência paga por si. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Cliente HTTP: nenhuma dependência.
             Ficamos com o java.net.http.HttpClient do próprio JDK, em vez de OkHttp ou
             Apache HttpClient, por três motivos:
               1. Precisamos DESLIGAR o follow-redirect automático e avaliar cada hop
                  contra o guarda de SSRF (ver GuardaSsrf). Redirects.NEVER é nativo, e
                  seguir na mão é o mesmo trabalho em qualquer uma das libs.
               2. BodyHandlers.ofInputStream() dá leitura em fluxo com corte duro no teto
                  de bytes, que é a única otimização de rede que importa aqui.
               3. Zero dependência nova a auditar em um projeto que roda em free tier e
                  faz requisição para domínio arbitrário submetido por terceiro.
             OkHttp só ganharia em pool de conexão por host, e a pré-análise abre no
             máximo uma conexão por host, uma vez a cada cooldown. -->

        <!-- MapStruct (mapeamento entidade <-> DTO) -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Lombok (versão gerenciada pelo BOM do Spring Boot) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Testes ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nome de artefato previsível (target/app.jar), usado pelo Dockerfile -->
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Processadores de anotação: Lombok + MapStruct -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
